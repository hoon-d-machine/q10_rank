{
  "name": "dy-ai",
  "compatibility_date": "2026-10-01",
  // /api/* 만 Worker(src/worker.js: 구글 시트 프록시)가 처리하고 나머지는 public/ 정적 파일
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // 예약 작업(UTC): 매일 15:20 = 00:20 KST 랭킹 수집, 월요일 00:00 = 09:00 KST 주간 리포트 메일
  "triggers": { "crons": ["20 15 * * *", "0 0 * * 1"] },
  "observability": { "enabled": true },
  // 공개값만. secret 은 wrangler secret put 으로: GOOGLE_SA_JSON, SHEET_ID, SUPABASE_SERVICE_KEY, CRON_TOKEN, RESEND_API_KEY, RECEIVER_EMAIL
  "vars": {
    "SUPABASE_URL": "https://dlgyvqcfastqguudzcob.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_gpElJE3Ag9JVB_9z2wWwqA_2kheALPF"
  }
}
