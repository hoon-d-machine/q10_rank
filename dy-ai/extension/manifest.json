{
  "manifest_version": 3,
  "name": "DY-AI Q10 수집",
  "version": "0.5.0",
  "description": "DY-AI 메인의 'Q10 수집' 버튼으로 Qoo10 판매자 통계(일자/품목별 거래, 일자별 거래, 페이지뷰)와 추가 항목(상품별 PV, 고객, 찜·장바구니, 광고센터 광고비·상품별 광고·키워드, Beauty Brand AD, 행사 달력)을 수집합니다. Qoo10 로그인 창 아이디·비밀번호 자동 입력.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "webRequest",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://qsm.qoo10.jp/*",
    "https://seller.qoo10.jp/*",
    "https://ads.qoo10.jp/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dy-ai.xogns1381.workers.dev/*",
        "http://localhost:8765/*",
        "http://127.0.0.1:8765/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://qsm.qoo10.jp/*"
      ],
      "js": [
        "qsm-login.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
